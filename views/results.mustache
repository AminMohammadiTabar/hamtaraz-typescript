<!doctype html>
<!-- v1 result screen: the user sees enhanced-mode outcome, no setup/config links.
     Aggregate balance MUST NOT be described as row-by-row verification. -->
<html lang="fa" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f5f7fb"><title>نتیجه مغایرت‌گیری | هم‌تراز</title><link rel="stylesheet" href="/assets/styles.css"></head>
<body><div class="app">
  <aside class="sidebar" aria-label="منوی سامانه">
    <a class="brand" href="/" aria-label="هم‌تراز، صفحه اصلی"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="M7 11h18M7 21h18M10 8l-3 3 3 3m12 4 3 3-3 3" stroke="currentColor" stroke-linecap="round" stroke-width="2.5"/></svg></span><span><span class="brand-title">هم‌تراز</span><span class="brand-caption">سامانه مغایرت‌گیری واریزی‌ها</span></span></a>
    <div class="menu-label">فضای کار</div><nav class="nav" aria-label="بخش‌های اصلی"><a href="/" class="nav-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0-12 4 4m-4-4L8 7"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg><span>بررسی جدید</span></a><a href="/results" class="nav-item active" aria-current="page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><span>نتایج آخرین بررسی</span></a></nav>
    <div class="sidebar-help"><span class="help-icon" aria-hidden="true">i</span><div><strong>شماره ردیف دقیق</strong><p>شماره‌های نمایش‌داده‌شده به ردیف واقعی فایل Excel اشاره دارند.</p></div></div><div class="sidebar-bottom"><span class="version-dot"></span> هم‌تراز <b>v1.0.1 TS.4</b><small>نسخه نخست محصول</small></div>
  </aside>
  <div class="workspace"><header class="header"><div class="crumb">خانه <span class="crumb-chevron">/</span> <strong>نتایج مغایرت‌گیری</strong></div><div class="header-right"><span class="environment-pill"><span class="live-dot"></span> بررسی تکمیل‌شده</span><span class="header-version">نسخه ۱.۰</span></div></header>
  <main class="content content-results">
    {{^hasRun}}<div class="empty-landing panel"><div class="empty-graphic" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="8" y="5" width="32" height="38" rx="5"/><path d="M16 17h16m-16 8h16m-16 8h9"/></svg></div><h1>هنوز گزارشی بررسی نشده است</h1><p>برای مشاهده نتایج، ابتدا فایل بانک ملی و TBS را بارگذاری کنید.</p><a href="/" class="btn btn-primary">رفتن به بارگذاری <span aria-hidden="true">←</span></a></div>{{/hasRun}}
    {{#hasRun}}
    <div class="results-top"><div class="results-heading"><span class="eyebrow">گزارش نهایی بررسی</span><h1>نتیجه مغایرت‌گیری</h1><p>خلاصه اختلاف‌ها و ردیف‌هایی که نیاز به توجه دارند.</p></div><div class="result-buttons"><a href="/" class="btn btn-secondary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14m-7-7h14"/></svg> بررسی جدید</a><a href="/results/download" class="btn btn-primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 17v4h14v-4"/></svg> دریافت گزارش Excel</a></div></div>
    <div class="result-status {{#balanced}}status-balanced{{/balanced}}{{#needsReview}}status-review{{/needsReview}}" role="status"><span class="status-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8m-4-4v8"/></svg></span><div><span class="status-label">وضعیت بررسی</span><strong>{{statusText}}</strong><p>بانک ملی: {{bankFilename}} <span class="sep-dot">•</span> کارگزاری TBS: {{tbsFilename}}</p></div></div>
    {{#balanced}}<div class="notice success" role="status">تعداد و مجموع مبالغ برابر بوده‌اند؛ مطابق قواعد کسب‌وکار، تطبیق ردیف‌به‌ردیف اجرا نشده است.</div>{{/balanced}}
    {{#needsReview}}<div class="notice warning" role="status">بعضی ردیف‌ها هنوز قابل تعیین قطعی نیستند. این موارد را با مغایرت قطعی اشتباه نگیرید.</div>{{/needsReview}}
    {{#identityNoticeMessage}}<div class="notice warning" role="status">{{identityNoticeMessage}}</div>{{/identityNoticeMessage}}
    <section class="metrics-grid" aria-label="آمار خلاصه مغایرت‌گیری">
      <div class="metric"><div class="metric-head"><span>تعداد واریزی‌های بانک</span><span class="metric-icon">۱</span></div><strong dir="ltr">{{bankCount}}</strong><small>ردیف قابل بررسی</small></div>
      <div class="metric"><div class="metric-head"><span>تعداد رکوردهای TBS</span><span class="metric-icon">۲</span></div><strong dir="ltr">{{tbsCount}}</strong><small>ردیف قابل بررسی</small></div>
      <div class="metric"><div class="metric-head"><span>اختلاف تعداد</span><span class="metric-icon">#</span></div><strong dir="ltr">{{countDifference}}</strong><small>بانک منهای TBS</small></div>
      <div class="metric metric--accent"><div class="metric-head"><span>اختلاف خالص مبلغ</span><span class="metric-icon">﷼</span></div><strong dir="ltr">{{amountDifference}}</strong><small>ریال</small></div>
    </section>
    <section class="panel totals-panel" aria-labelledby="totals-title"><div class="panel-header"><div><span class="step-label">مقایسه تجمیعی</span><h2 class="panel-title" id="totals-title">مجموع مبالغ واریزی</h2><p class="panel-desc">پس از کنارگذاشتن ردیف‌های مستثنا، به ریال</p></div><span class="hint-tag">کنترل مبالغ</span></div><div class="totals-grid"><div class="total-item"><span>بانک ملی</span><strong dir="ltr">{{bankTotal}}</strong></div><div class="totals-divider" aria-hidden="true">⇆</div><div class="total-item"><span>کارگزاری TBS</span><strong dir="ltr">{{tbsTotal}}</strong></div></div></section>
    <section class="panel exceptions-panel" aria-labelledby="exceptions-title"><div class="panel-header"><div><span class="step-label">جزئیات قابل پیگیری</span><h2 class="panel-title" id="exceptions-title">ردیف‌های نیازمند توجه</h2><p class="panel-desc">فقط مغایرت‌های ثبت‌شده و مواردی که شواهد کافی ندارند.</p></div></div>
      <div class="exception-summary"><div><span class="summary-dot bank-dot"></span><strong>{{bankOnlyCount}}</strong><small>فقط در بانک ملی</small></div><div><span class="summary-dot tbs-dot"></span><strong>{{tbsOnlyCount}}</strong><small>فقط در TBS</small></div><div><span class="summary-dot unresolved-dot"></span><strong>{{unresolvedCount}}</strong><small>نیازمند بررسی</small></div></div>
      <div class="table-header"><nav class="filter-row" aria-label="فیلتر ردیف‌های مغایر"><a href="/results?type=ALL" class="filter {{#filterAll}}selected{{/filterAll}}" {{#filterAll}}aria-current="page"{{/filterAll}}>همه</a><a href="/results?type=BANK_ONLY" class="filter {{#filterBank}}selected{{/filterBank}}" {{#filterBank}}aria-current="page"{{/filterBank}}>فقط بانک</a><a href="/results?type=TBS_ONLY" class="filter {{#filterTbs}}selected{{/filterTbs}}" {{#filterTbs}}aria-current="page"{{/filterTbs}}>فقط TBS</a><a href="/results?type=UNRESOLVED" class="filter {{#filterUnresolved}}selected{{/filterUnresolved}}" {{#filterUnresolved}}aria-current="page"{{/filterUnresolved}}>نامشخص</a></nav><span class="list-counter">{{totalRows}} ردیف</span></div>
      {{^hasRows}}<div class="empty-table"><span class="empty-check" aria-hidden="true">✓</span><strong>ردیفی در این دسته وجود ندارد</strong><span>می‌توانید فیلتر دیگری را انتخاب کنید.</span></div>{{/hasRows}}
      {{#hasRows}}<div class="table-scroll"><table class="result-table"><thead><tr><th scope="col">منبع</th><th scope="col">ردیف اکسل</th><th scope="col">تاریخ</th><th scope="col">مبلغ (ریال)</th><th scope="col">شماره پیگیری</th><th scope="col">شیت</th><th scope="col">وضعیت</th><th scope="col">دلیل</th></tr></thead><tbody>{{#rows}}<tr><td class="source-cell">{{source}}</td><td><strong class="excel-row" dir="ltr">{{row}}</strong></td><td dir="ltr">{{date}}</td><td dir="ltr" class="amount-cell">{{amount}}</td><td><span class="code-value" dir="ltr">{{tracking}}</span></td><td>{{sheet}}</td><td><span class="row-status row-status--{{statusClass}}">{{type}}</span></td><td class="reason-cell">{{reason}}</td></tr>{{/rows}}</tbody></table></div>{{/hasRows}}
      <div class="pager"><div><span>نمایش {{pageFrom}} تا {{pageTo}} از {{totalRows}} ردیف</span><small>صفحه {{currentPage}} از {{totalPages}}</small></div><div class="pager-actions">{{#hasPrevious}}<a class="btn btn-secondary btn-page" href="{{previousUrl}}" aria-label="صفحه قبل">قبلی</a>{{/hasPrevious}}{{#hasNext}}<a class="btn btn-secondary btn-page" href="{{nextUrl}}" aria-label="صفحه بعد">بعدی</a>{{/hasNext}}</div></div>
    </section>
    <div class="privacy-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 11v5m0-8v.1"/></svg><span>شماره ردیف‌ها به فایل اصلی Excel اشاره می‌کنند. نتیجه‌های «نامشخص» نیازمند بررسی تکمیلی هستند و مغایرت قطعی محسوب نمی‌شوند.</span></div>
    {{/hasRun}}
  </main></div>
</div></body></html>
