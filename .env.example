# App server
PORT=8080
# When serving behind HTTPS, set to true and terminate TLS at a trusted reverse proxy
COOKIE_SECURE=false
# Run npm commands from the project root; otherwise specify absolute project path
# HAMTARAZ_ROOT=/path/to/hamtaraz-typescript

# Legacy identity workflow (not public in v1; source retained for later release)
IDENTITY_INTERVAL_SECONDS=10
IDENTITY_CONNECT_TIMEOUT_SECONDS=5
IDENTITY_READ_TIMEOUT_SECONDS=10
IDENTITY_ALLOWED_HOSTS=

# Golden test files (optional; never check financial reports into source control)
# GOLDEN_BANK=/path/to/bank.xlsx
# GOLDEN_TBS=/path/to/tbs.xlsx
